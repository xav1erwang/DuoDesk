.build/
.swiftpm/
xcuserdata/
*.xcuserstate
DerivedData/
Temp/
Local/
Build/
.env
.env.*
.DS_Store

# Signing and notary keys, certificates exported with their keys, provisioning profiles and
# keychains: never in the repository (docs/release-checklist.md keeps them outside it).
*.p12
*.pfx
*.p8
*.key
AuthKey_*
*.pem
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db

# The sizzle reel's renders (design/reel, over a gigabyte): kept out of git.
design/reel/

# Python's bytecode caches (Tests/checks/module.py, which its checks' mutants.py import).
__pycache__/

# Local credentials and private captures. Ignore rules do not erase Git history.
.netrc
.npmrc
.pypirc
.ssh/
.aws/
.gnupg/
id_rsa*
id_ed25519*
*.keystore
*.jks
*.kdbx
*.ovpn
*.har
*.pcap
*.pcapng
